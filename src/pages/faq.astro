---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.imagesizechanger.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "FAQ",
      "item": "https://www.imagesizechanger.info/faq"
    }
  ]
};

const faqQuestions = [
  {
    q: "What is an image size changer?",
    a: "An image size changer is a digital tool that modifies the pixel dimensions (width and height) of a digital picture or graphic. It lets you downscale large photos for websites, resize banners for social media, or adjust dimensions to fit specific display containers."
  },
  {
    q: "Is ImageSizeChanger.info completely free to use?",
    a: "Yes. ImageSizeChanger is 100% free to use. There are no subscriptions, no hidden fees, no usage limits, and no account creation required."
  },
  {
    q: "Do I need to install any software or browser extensions?",
    a: "No software installation is necessary. ImageSizeChanger operates directly inside your web browser using HTML5 Canvas technology on Windows, Mac, Linux, iOS, and Android."
  },
  {
    q: "How do I resize an image on this website?",
    a: "Select or drag your image into the tool workspace, enter your desired width or height in pixels or percentage (or select a social media preset), keep the aspect ratio locked to prevent distortion, choose your target format, and click the Resize button to download your processed file."
  },
  {
    q: "How do I maintain the original aspect ratio when resizing?",
    a: "By default, the aspect ratio lock (🔗 icon) is active. When enabled, typing a new width automatically calculates the proportional height (and vice versa) based on the image's original ratio, preventing any stretching or squishing."
  },
  {
    q: "Why does my image look stretched or squashed?",
    a: "Images appear stretched or distorted when the width and height are changed independently with the aspect ratio unlocked. To preserve the natural look of people and objects, always keep the aspect ratio lock enabled."
  },
  {
    q: "Why does an image look blurry after making it larger?",
    a: "Raster images are made of a fixed grid of pixels. When you upscale a small image (e.g., from 300px to 1500px), software has to invent missing pixel data through interpolation, which makes edges look soft or pixelated. For best results, always downscale from high-resolution master originals."
  },
  {
    q: "What image formats are supported?",
    a: "ImageSizeChanger supports reading and processing JPG (JPEG), PNG, WebP, GIF, and BMP files. You can export your processed images as JPG, PNG, or WebP."
  },
  {
    q: "Can I resize JPG / JPEG images?",
    a: "Yes. JPG files can be resized in dimensions and compressed in quality. You can also specify an optional target file size in KB or MB to meet upload requirements."
  },
  {
    q: "Can I resize PNG images with transparent backgrounds?",
    a: "Yes. When exporting to PNG or WebP, transparency is fully preserved. If you export a transparent PNG to JPG, the transparent areas will automatically be filled with a clean white background."
  },
  {
    q: "Can I resize WebP images?",
    a: "Yes. WebP images can be resized, converted, or compressed directly in the browser with full support for modern web standards."
  },
  {
    q: "Are my uploaded images stored or sent to a server?",
    a: "No. All image processing occurs locally inside your web browser using HTML5 Canvas APIs. Your images are never uploaded to, transmitted across, or stored on our servers. Your photos stay 100% private on your device."
  },
  {
    q: "Can I use ImageSizeChanger on a mobile phone or tablet?",
    a: "Yes. ImageSizeChanger is fully responsive and optimized for mobile devices on iOS (Safari, Chrome) and Android (Chrome, Firefox). You can also install it as a Progressive Web App (PWA) on your home screen for quick offline access."
  },
  {
    q: "Can I reduce image file size to meet online form upload limits (e.g. under 50 KB or 100 KB)?",
    a: "Yes. You can enter an exact target size (such as 50 KB or 100 KB) in the export settings. The tool's compression algorithm will automatically optimize the JPEG/WebP quality to get as close as possible under your specified limit."
  },
  {
    q: "Can I resize multiple images at the same time (batch resizing)?",
    a: "Yes. You can select or drag multiple image files into the workspace. The tool will process and download each resized image sequentially."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqQuestions.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="Frequently Asked Questions (FAQ) — ImageSizeChanger"
  description="Find answers to common questions about resizing image dimensions, maintaining aspect ratios, in-browser privacy, supported formats, and file compression on ImageSizeChanger."
  structuredData={[breadcrumbSchema, faqSchema]}
>
  <Header />

  <main class="legal-page">
    <div class="container narrow-container">

      <div class="status-pill">
        <span class="status-dot"></span>
        Help Center & FAQ
      </div>

      <h1>Frequently Asked Questions</h1>

      <p class="lead">
        Find clear, detailed answers about how ImageSizeChanger works, our client-side privacy model, supported image formats, and best practices for resizing without distortion.
      </p>

      <div class="legal-card" style="margin-top: 2rem;">
        <div class="faq-list">
          {faqQuestions.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="legal-card" style="margin-top: 2rem; text-align: center;">
        <h2>Ready to resize an image?</h2>
        <p style="margin-bottom: 1.5rem;">
          Try our free browser-based resizer now. Fast, private, and no signup needed.
        </p>
        <a class="primary-button" href="/resize-image" style="display: inline-flex; width: auto; padding: 0.75rem 1.75rem;">
          Open Image Resizer <span>↗</span>
        </a>
      </div>

      <div style="margin-top: 2rem; display: flex; justify-content: space-between;">
        <a class="back-link" href="/">← Back to Home</a>
        <a class="back-link" href="/guides">Browse Educational Guides →</a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
