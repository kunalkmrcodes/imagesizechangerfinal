---
import "../styles/global.css";
---

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Contact — ImageSizeChanger</title>

  <meta
    name="description"
    content="Contact the ImageSizeChanger team."
  />

  <link
    rel="icon"
    type="image/png"
    href="/favicon.png"
  />

</head>


<body>


<header class="site-header">

  <div class="container nav-inner">


    <a class="brand" href="/">

      <img
        src="/favicon.png"
        alt=""
        class="brand-icon"
      />

      <span>
        ImageSizeChanger
      </span>

    </a>



    <nav class="nav-links">

      <a href="/#resize">
        Resize
      </a>

      <a href="/#features">
        Features
      </a>

      <a href="/#faq">
        FAQ
      </a>

    </nav>



    <a
      class="nav-cta"
      href="/#resize"
    >

      Start resizing

    </a>


  </div>

</header>




<main class="legal-page">


  <div class="container narrow-container">


    <div class="status-pill">

      <span class="status-dot"></span>

      Get in touch

    </div>



    <h1>
      Contact us.
    </h1>



    <p class="lead">

      Have a question, found a problem, or have a suggestion?
      We'd love to hear from you.

    </p>




    <div class="contact-card">


      <div class="contact-icon">
        ✉
      </div>



      <span class="control-eyebrow">
        EMAIL
      </span>



      <h2>
        ImageSizeChanger Support
      </h2>



      <p>

        Send us a message and we'll get back to you as soon as possible.

      </p>



      <a
        class="primary-button contact-button"
        href="mailto:imagesizechanger@gmail.com"
      >

        Email us

        <span>
          ↗
        </span>

      </a>



      <div class="email-address">

        imagesizechanger@gmail.com

      </div>



    </div>




    <a
      class="back-link"
      href="/"
    >

      ← Back to ImageSizeChanger

    </a>



  </div>


</main>





<footer class="site-footer">


  <div class="container footer-bottom">


    <span>
      © 2026 ImageSizeChanger
    </span>



    <div class="footer-links">


      <a href="/about">
        About
      </a>


      <a href="/privacy">
        Privacy
      </a>


      <a href="/terms">
        Terms
      </a>


      <a href="/contact">
        Contact
      </a>


    </div>


  </div>


</footer>




</body>

</html>