---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://imagesizechanger-com.vercel.app/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://imagesizechanger-com.vercel.app/contact"
    }
  ]
};
---

<Layout
  title="Contact Us — ImageSizeChanger"
  description="Contact the ImageSizeChanger team for technical support, feedback, bug reports, privacy questions, or feature suggestions."
  structuredData={breadcrumbSchema}
>
  <Header />

  <main class="legal-page">
    <div class="container narrow-container">

      <div class="status-pill">
        <span class="status-dot"></span>
        Get in Touch
      </div>

      <h1>Contact Us</h1>

      <p class="lead">
        Have a technical question, found a bug, or have a suggestion to improve ImageSizeChanger? We welcome your feedback and inquiries.
      </p>

      <div class="legal-card">
        <h2>How We Can Help</h2>
        <p>You can reach out to our team regarding any of the following support topics:</p>
        <ul>
          <li><strong>Technical Problems:</strong> Reporting issues with image loading, canvas rendering, or file downloads.</li>
          <li><strong>Feature Suggestions:</strong> Recommending new dimensions presets, format support, or tool enhancements.</li>
          <li><strong>Feedback & Corrections:</strong> Alerting us to outdated guide content or user experience improvements.</li>
          <li><strong>Privacy Inquiries:</strong> Questions regarding data handling, cookies, or privacy policy details.</li>
        </ul>

        <div class="contact-card" style="margin-top: 2rem;">
          <div class="contact-icon">✉</div>
          <span class="control-eyebrow">DIRECT EMAIL SUPPORT</span>
          <h2>ImageSizeChanger Support</h2>
          <p>Send us an email and we will respond as soon as possible.</p>

          <a
            class="primary-button contact-button"
            href="mailto:imagesizechanger@gmail.com"
          >
            Email us <span>↗</span>
          </a>

          <div class="email-address">imagesizechanger@gmail.com</div>
        </div>
      </div>

      <a class="back-link" href="/">← Back to ImageSizeChanger</a>
    </div>
  </main>

  <Footer />
</Layout>