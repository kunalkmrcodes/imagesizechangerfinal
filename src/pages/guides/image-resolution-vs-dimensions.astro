const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Image Resolution vs Image Dimensions: What's the Difference?",
  "description": "Demystify pixel dimensions (width × height) vs PPI/DPI resolution, print vs digital display requirements, and common misconceptions.",
  "author": {
    "@type": "Organization",
    "name": "ImageSizeChanger"
  }
