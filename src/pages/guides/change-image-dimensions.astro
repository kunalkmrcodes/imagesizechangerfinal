const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to Change Image Width and Height (Pixels vs Percentage)",
  "description": "Learn how to accurately change image width and height in pixels or percentage, calculate aspect ratios, and avoid image distortion.",
  "author": {
    "@type": "Organization",
    "name": "ImageSizeChanger"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ImageSizeChanger",
    "logo": {
      "@type": "ImageObject",
