  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.imagesizechanger.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guides",
      "item": "https://www.imagesizechanger.info/guides"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "How to Change Image Width and Height",
      "item": "https://www.imagesizechanger.info/guides/change-image-dimensions"
    }
  ]
