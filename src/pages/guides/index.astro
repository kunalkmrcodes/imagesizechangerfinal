---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.imagesizechanger.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guides",
      "item": "https://www.imagesizechanger.info/guides"
    }
  ]
};

const guides = [
  {
    title: "How to Resize an Image Without Losing Quality",
    slug: "how-to-resize-an-image",
    category: "Resizing & Quality",
    description: "Learn how image dimensions, resampling, aspect ratios, and format choices affect visual sharpness when downscaling or upscaling images."
  },
  {
    title: "How to Change Image Width and Height",
    slug: "change-image-dimensions",
    category: "Dimension Editing",
    description: "Master pixel dimensions vs percentage scaling, aspect ratio formulas, and practical tips to prevent squishing or stretching."
  },
  {
    title: "Image Size vs File Size: What's the Difference?",
    slug: "image-size-vs-file-size",
    category: "Fundamentals",
    description: "Demystify on-screen pixel dimensions (1920 × 1080) vs storage file weight in KB or MB and understand how both interact."
  },
  {
    title: "Understanding Image Aspect Ratio",
    slug: "image-aspect-ratio-guide",
    category: "Aspect Ratios",
    description: "Comprehensive guide to 1:1, 16:9, 4:3, and 1.91:1 ratios, proportional scaling math, and clean cropping."
  },
  {
    title: "JPG vs PNG vs WebP: Which Image Format Should You Use?",
    slug: "jpg-vs-png-vs-webp",
    category: "Formats",
    description: "A complete side-by-side comparison of JPG, PNG, and WebP image formats, color handling, transparency support, and ideal use cases."
  },
  {
    title: "How to Resize Images for Websites",
    slug: "resize-images-for-websites",
    category: "Web Performance",
    description: "Optimize web graphics, hero banners, and blog thumbnails for layout containers to speed up page load times and boost Core Web Vitals (LCP)."
  },
  {
    title: "Common Image Sizes for Social Media",
    slug: "social-media-image-sizes",
    category: "Social Media",
    description: "Up-to-date dimensions cheat sheet for Instagram, Facebook, YouTube, Twitter/X, and LinkedIn to avoid automatic cropping and blur."
  },
  {
    title: "How to Reduce Image File Size",
    slug: "reduce-image-file-size",
    category: "Compression",
    description: "Discover practical strategies to shrink image weight in KB or MB using dimension tuning, lossy vs lossless compression, and modern codecs."
  },
  {
    title: "How to Convert PNG to JPG",
    slug: "how-to-convert-png-to-jpg",
    category: "Conversion",
    description: "Step-by-step instructions on converting large PNG screenshots or graphics to lightweight JPGs, including handling transparent backgrounds."
  },
  {
    title: "How to Make an Image Smaller for Online Forms",
    slug: "how-to-make-an-image-smaller-for-online-forms",
    category: "Forms & Uploads",
    description: "Learn how to meet strict file size limits (e.g. under 50 KB or 100 KB) for job applications, passport submissions, and government portal uploads."
  }
];
---

<Layout
  title="Image Resizing & Compression Guides | Image Size Changer"
  description="Explore comprehensive tutorials and guides on image dimensions, file compression, format conversion (JPG, PNG, WebP), aspect ratios, and web optimization."
  structuredData={breadcrumbSchema}
>
  <Header />

  <main class="legal-page">
    <div class="container">

      <div class="status-pill">
        <span class="status-dot"></span>
        Educational Library
      </div>

      <h1>Image Resizing & Compression Guides</h1>

      <p class="lead">
        Explore our in-depth tutorials to understand image dimensions, file compression techniques, format selection, aspect ratio math, and web performance best practices.
      </p>

      <div class="guides-grid">
        {guides.map((guide) => (
          <article class="guide-card">
            <span class="guide-category">{guide.category}</span>
            <h2>
              <a href={`/guides/${guide.slug}/`}>
                {guide.title}
              </a>
            </h2>
            <p>{guide.description}</p>
            <a class="read-link" href={`/guides/${guide.slug}/`}>
              Read guide →
            </a>
          </article>
        ))}
      </div>

      <div class="legal-card" style="margin-top: 3rem; text-align: center;">
        <h2>Need to resize an image right now?</h2>
        <p style="margin-bottom: 1.5rem;">
          Use our free, private, client-side tool to change dimensions and compress files in seconds.
        </p>
        <a class="primary-button" href="/resize-image" style="display: inline-flex; width: auto; padding: 0.75rem 1.75rem;">
          Launch Image Resizer <span>↗</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .guide-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .guide-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-border);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .guide-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .guide-card h2 {
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--text-heading);
    margin-bottom: 0.75rem;
  }

  .guide-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .guide-card h2 a:hover {
    color: var(--accent);
  }

  .guide-card p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .read-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }
</style>
