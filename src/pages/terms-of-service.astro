---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.imagesizechanger.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Terms of Service",
      "item": "https://www.imagesizechanger.info/terms-of-service"
    }
  ]
};
---

<Layout
  title="Terms of Service — ImageSizeChanger"
  description="Review the Terms of Service for ImageSizeChanger. Understand user rights, permitted usage, local processing terms, and content responsibilities."
  structuredData={breadcrumbSchema}
>
  <Header />

  <main class="legal-page">
    <div class="container narrow-container">

      <div class="status-pill">
        <span class="status-dot"></span>
        Terms of Service
      </div>

      <h1>Terms of Service</h1>

      <p class="lead">
        Welcome to ImageSizeChanger. By accessing or using our website, tools, and educational guides, you agree to comply with and be bound by the following Terms of Service.
      </p>

      <div class="legal-card">
        <h2>1. Acceptance of Terms</h2>
        <p>
          By visiting, accessing, or utilizing any feature of ImageSizeChanger (the "Service"), you confirm that you have read, understood, and agreed to be legally bound by these Terms of Service. If you do not agree with any part of these terms, please discontinue use of the site.
        </p>

        <h2>2. Description of the Service</h2>
        <p>
          ImageSizeChanger provides free, browser-based digital utilities that allow users to change pixel dimensions, compress file sizes, and convert file formats for digital raster images. We also publish original educational resources, guides, and reference materials about digital image optimization.
        </p>

        <h2>3. Permitted & Lawful Use</h2>
        <p>
          You agree to use ImageSizeChanger only for lawful purposes. You agree not to:
        </p>
        <ul>
          <li>Attempt to reverse-engineer, decompile, or compromise the technical infrastructure of the website.</li>
          <li>Engage in automated scraping, denial of service attacks, or excessive requests intended to impair service availability for other users.</li>
          <li>Use the tools to process unlawful, defamatory, harassing, or infringing content.</li>
        </ul>

        <h2>4. User Content & Intellectual Property Rights</h2>
        <p>
          You retain full ownership and intellectual property rights over any images, graphics, or documents you select for processing on ImageSizeChanger.
        </p>
        <p>
          You represent and warrant that you own or possess the necessary rights, licenses, and permissions to edit, resize, and convert any files you process using our tools. ImageSizeChanger does not claim any ownership over your user content.
        </p>

        <h2>5. Client-Side Processing Architecture</h2>
        <p>
          ImageSizeChanger executes all image manipulation algorithms locally inside your client web browser via HTML5 Canvas APIs. Because image files are processed on your local device and are not uploaded to our servers, you are solely responsible for saving and backing up your processed files to your device.
        </p>

        <h2>6. Website Content & Intellectual Property</h2>
        <p>
          All original educational articles, guides, tutorials, illustrations, logos, trademarks, and code on ImageSizeChanger are the intellectual property of ImageSizeChanger.info and are protected by applicable copyright laws. You may not reproduce, syndicate, or republish our editorial guides in bulk without prior written permission.
        </p>

        <h2>7. Disclaimer of Warranties</h2>
        <p>
          ImageSizeChanger is provided on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind, whether express or implied. While we strive to ensure our resizing and compression algorithms work accurately across all modern browsers, we do not guarantee that output files will meet specific third-party portal upload requirements or that the service will be entirely error-free.
        </p>

        <h2>8. Limitation of Liability</h2>
        <p>
          To the maximum extent permitted by applicable law, ImageSizeChanger and its operators shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or loss of data, arising out of your access to or use of the service.
        </p>

        <h2>9. Modifications to the Service and Terms</h2>
        <p>
          We reserve the right to modify, improve, or update these Terms of Service or discontinue features of the website at any time. Changes become effective immediately upon publication on this page.
        </p>

        <h2>10. Contact Information</h2>
        <p>
          If you have questions regarding these Terms of Service, please reach out via email at <strong>imagesizechanger@gmail.com</strong> or visit our <a href="/contact">Contact Page</a>.
        </p>

        <p class="updated">Last updated: August 2026</p>
      </div>

      <a class="back-link" href="/">← Back to ImageSizeChanger</a>
    </div>
  </main>

  <Footer />
</Layout>
