---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://imagesizechanger-com.vercel.app/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Privacy Policy",
      "item": "https://imagesizechanger-com.vercel.app/privacy"
    }
  ]
};
---

<Layout
  title="Privacy Policy — ImageSizeChanger"
  description="Read the ImageSizeChanger Privacy Policy regarding in-browser image processing, local storage, and Google Analytics."
  structuredData={breadcrumbSchema}
>
  <Header />

  <main class="legal-page">
    <div class="container narrow-container">

      <div class="status-pill">
        <span class="status-dot"></span>
        Privacy Policy
      </div>

      <h1>Privacy Policy</h1>

      <p class="lead">
        Your privacy is critically important to us. This Privacy Policy accurately details how ImageSizeChanger handles data and safeguards visitor information when you use our website.
      </p>

      <div class="legal-card">
        <h2>1. In-Browser Local Image Processing</h2>
        <p>
          ImageSizeChanger operates entirely as a client-side web application. All image resizing, cropping, quality compression, and format conversions execute locally within your web browser using HTML5 Canvas APIs. Your selected image files are never transferred to, stored on, or processed by our web servers.
        </p>

        <h2>2. Server Log Files</h2>
        <p>
          Like standard web servers, non-personally identifiable technical information automatically provided by web browsers (such as browser type, operating system, language preferences, referring pages, and access timestamps) is logged to monitor network security and server performance.
        </p>

        <h2>3. Local Storage</h2>
        <p>
          ImageSizeChanger uses browser <code>localStorage</code> to remember certain user preferences, such as whether the cookie/analytics notice has been dismissed. This information is stored locally in your browser and is not used by ImageSizeChanger to create personal tracking profiles or store user credentials.
        </p>
        <p>
          If cookies or other browser storage technologies are introduced in the future, this Privacy Policy will be updated to describe their use accurately.
        </p>

        <h2>4. Web Analytics (Google Analytics)</h2>
        <p>
          We use Google Analytics to understand how visitors use ImageSizeChanger, including overall website traffic, popular pages, and device/browser information.
        </p>
        <p>
          Google Analytics may use cookies and similar technologies to collect usage information. The information is used to help us understand website performance and improve the service.
        </p>
        <p>
          For more information about how Google handles data, please refer to <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy and Terms</a>.
        </p>

        <h2>5. Advertising Policy Notice</h2>
        <p>
          Third-party advertising services (such as Google AdSense) are not currently active on this website. If advertising networks or third-party ad cookies are integrated in the future, this Privacy Policy will be updated to disclose relevant advertising cookies and user opt-out options in compliance with applicable laws.
        </p>

        <h2>6. Contact Us</h2>
        <p>
          If you have questions or require further information regarding our Privacy Policy, please contact us via email at <strong>imagesizechanger@gmail.com</strong> or visit our <a href="/contact">Contact Page</a>.
        </p>

        <p class="updated">Last updated: August 2026</p>
      </div>

      <a class="back-link" href="/">← Back to ImageSizeChanger</a>
    </div>
  </main>

  <Footer />
</Layout>