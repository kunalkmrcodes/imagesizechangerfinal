---
import "../styles/global.css";
---

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Privacy Policy — ImageSizeChanger</title>

  <meta
    name="description"
    content="Read the ImageSizeChanger Privacy Policy and learn how information is handled when you use the website."
  />

  <link
    rel="icon"
    type="image/png"
    href="/favicon.png"
  />

</head>


<body>


<header class="site-header">

  <div class="container nav-inner">


    <a class="brand" href="/">

      <img
        src="/favicon.png"
        alt=""
        class="brand-icon"
      />

      <span>
        ImageSizeChanger
      </span>

    </a>



    <nav class="nav-links">

      <a href="/#resize">
        Resize
      </a>

      <a href="/#features">
        Features
      </a>

      <a href="/#faq">
        FAQ
      </a>

    </nav>



    <a
      class="nav-cta"
      href="/#resize"
    >
      Start resizing
    </a>


  </div>

</header>



<main class="legal-page">


  <div class="container narrow-container">


    <div class="status-pill">

      <span class="status-dot"></span>

      Privacy

    </div>



    <h1>
      Privacy Policy
    </h1>



    <p class="lead">

      Your privacy matters. This page explains how ImageSizeChanger
      handles information when you use the website.

    </p>



    <div class="legal-card">


      <h2>
        Image processing
      </h2>


      <p>

        The image resizing tool is designed to process selected images
        directly inside your browser. The website does not need to upload
        the images to a server for the resizing operation.

      </p>



      <h2>
        Information you provide
      </h2>


      <p>

        You can use the image resizer without creating an account.
        Images selected for resizing remain available to the browser
        during your session so the requested operation can be completed.

      </p>



      <h2>
        Contact information
      </h2>


      <p>

        If you contact us by email, we will receive the information you
        include in your message and use it to respond to your request.

      </p>



      <h2>
        Third-party services
      </h2>


      <p>

        If third-party services such as analytics, advertising or hosting
        tools are added to the website in the future, this policy may be
        updated to explain their use.

      </p>



      <h2>
        Changes to this policy
      </h2>


      <p>

        We may update this Privacy Policy when the website or its
        services change.

      </p>



      <p class="updated">

        Last updated: August 2026

      </p>


    </div>



    <a
      class="back-link"
      href="/"
    >

      ← Back to ImageSizeChanger

    </a>



  </div>


</main>




<footer class="site-footer">


  <div class="container footer-bottom">


    <span>
      © 2026 ImageSizeChanger
    </span>



    <div class="footer-links">


      <a href="/about">
        About
      </a>


      <a href="/privacy">
        Privacy
      </a>


      <a href="/terms">
        Terms
      </a>


      <a href="/contact">
        Contact
      </a>


    </div>


  </div>


</footer>



</body>

</html>