---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>About — ImageSizeChanger</title>

  <meta
    name="description"
    content="Learn more about ImageSizeChanger and our simple browser-based image tools."
  />

  <link
    rel="icon"
    type="image/png"
    href="/favicon.png"
  />
</head>

<body>

<header class="site-header">
  <div class="container nav-inner">

    <a class="brand" href="/">
      <img
        src="/favicon.png"
        alt=""
        class="brand-icon"
      />

      <span>
        ImageSizeChanger
      </span>
    </a>


    <nav class="nav-links">
      <a href="/#resize">
        Resize
      </a>

      <a href="/#features">
        Features
      </a>

      <a href="/#faq">
        FAQ
      </a>
    </nav>


    <a
      class="nav-cta"
      href="/#resize"
    >
      Start resizing
    </a>

  </div>
</header>


<main class="legal-page">

  <div class="container narrow-container">

    <div class="status-pill">
      <span class="status-dot"></span>
      About ImageSizeChanger
    </div>


    <h1>
      Simple image tools,
      built for everyday use.
    </h1>


    <p class="lead">
      ImageSizeChanger is designed to make common image tasks quick,
      straightforward and accessible from your browser.
    </p>


    <div class="legal-card">

      <h2>
        Our goal
      </h2>

      <p>
        We want image editing tools to feel simple. You shouldn't need
        complicated software just to change an image's dimensions or format.
      </p>


      <h2>
        Built for simplicity
      </h2>

      <p>
        ImageSizeChanger focuses on practical image operations such as
        resizing, changing output quality and converting between common
        image formats.
      </p>


      <h2>
        Privacy-focused processing
      </h2>

      <p>
        The image resizer is designed to process images directly in your
        browser, so you can resize files without intentionally uploading
        them to our servers.
      </p>

    </div>


    <a
      class="back-link"
      href="/"
    >
      ← Back to ImageSizeChanger
    </a>


  </div>

</main>


<footer class="site-footer">

  <div class="container footer-bottom">

    <span>
      © 2026 ImageSizeChanger
    </span>


    <div class="footer-links">

      <a href="/about">
        About
      </a>

      <a href="/privacy">
        Privacy
      </a>

      <a href="/terms">
        Terms
      </a>

      <a href="/contact">
        Contact
      </a>

    </div>

  </div>

</footer>


</body>
</html>