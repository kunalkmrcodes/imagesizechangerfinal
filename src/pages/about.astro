---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.imagesizechanger.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About",
      "item": "https://www.imagesizechanger.info/about"
    }
  ]
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About ImageSizeChanger",
  "url": "https://www.imagesizechanger.info/about",
  "description": "Learn about ImageSizeChanger, an independent, free, browser-based image utility built for privacy, simplicity, and fast client-side image editing."
};
---

<Layout
  title="About Us — ImageSizeChanger"
  description="Learn about ImageSizeChanger, an independent web utility built to provide private, fast, in-browser image resizing, compression, and format conversion without server uploads."
  structuredData={[breadcrumbSchema, aboutSchema]}
>
  <Header />

  <main class="legal-page">
    <div class="container narrow-container">

      <div class="status-pill">
        <span class="status-dot"></span>
        About ImageSizeChanger
      </div>

      <h1>About ImageSizeChanger</h1>

      <p class="lead">
        ImageSizeChanger is an independent, free online image utility created to solve a universal everyday challenge: resizing, compressing, and converting digital images quickly without uploading personal files to remote servers or dealing with complex desktop software.
      </p>

      <div class="legal-card">
        <h2>Our Mission</h2>
        <p>
          Digital images are everywhere—from website hero banners and blog post graphics to passport submissions, job portal uploads, and social media feeds. Yet, many people face frustrating hurdles when attempting to resize or compress an image: bloated software that takes minutes to open, paywalled online tools, or privacy concerns when uploading sensitive photos to unknown servers.
        </p>
        <p>
          ImageSizeChanger was built with a simple goal: to provide an intuitive, high-performance web tool where anyone can modify image dimensions, maintain aspect ratios, reduce file weights in KB or MB, and convert formats directly inside their web browser.
        </p>

        <h2>How Image Processing Works (Privacy by Design)</h2>
        <p>
          Unlike conventional online converters that transfer your pictures to a remote backend server for processing, ImageSizeChanger is engineered as a <strong>100% client-side web application</strong>.
        </p>
        <ul>
          <li><strong>Zero Server Uploads:</strong> When you select an image, it is read into your browser's local memory using HTML5 File APIs and Canvas technology.</li>
          <li><strong>Local Execution:</strong> Resampling, aspect ratio calculation, compression, and format conversion algorithms execute directly on your device's CPU/GPU.</li>
          <li><strong>Instant Privacy:</strong> Your photos never leave your device. Once you close the browser tab or remove the image, the data is completely cleared from memory.</li>
        </ul>

        <h2>What Tools and Resources We Offer</h2>
        <p>
          ImageSizeChanger combines practical utilities with in-depth educational resources:
        </p>
        <ul>
          <li><strong><a href="/resize-image">Image Size Changer</a>:</strong> Scale width and height in exact pixels or percentages with aspect ratio locking and standard social media presets.</li>
          <li><strong><a href="/compress-image">Image Compressor</a>:</strong> Specify target file size limits in KB or MB to satisfy strict submission forms or improve web loading times.</li>
          <li><strong><a href="/convert-image">Format Converter</a>:</strong> Switch seamlessly between JPG, PNG, and WebP formats.</li>
          <li><strong><a href="/guides">Educational Guides Library</a>:</strong> Thorough, practical tutorials explaining pixel dimensions vs file weight, aspect ratios, format trade-offs, and image optimization for web performance.</li>
        </ul>

        <h2>Who Uses ImageSizeChanger?</h2>
        <p>
          ImageSizeChanger is built for anyone who works with digital pictures:
        </p>
        <ul>
          <li><strong>Job applicants & students</strong> preparing profile photos or scanned documents for online portals with strict 50 KB or 100 KB limits.</li>
          <li><strong>Webmasters & bloggers</strong> optimizing graphics to improve Core Web Vitals and page load speeds.</li>
          <li><strong>Content creators & social media managers</strong> sizing banners and posts for Instagram, Facebook, YouTube, and X (Twitter).</li>
          <li><strong>Everyday computer users</strong> needing a clean, trustworthy tool without creating accounts or downloading bulky software.</li>
        </ul>

        <h2>Editorial and Quality Standards</h2>
        <p>
          Our guides and documentation are written and maintained to deliver factual, practical advice on digital image editing. We do not make exaggerated claims, and we regularly verify that our technical explanations reflect standard image processing science and web specifications.
        </p>

        <h2>Contact Us</h2>
        <p>
          We welcome suggestions, questions, and bug reports from our community. If you would like to get in touch, please visit our <a href="/contact">Contact Page</a> or send an email to <strong>imagesizechanger@gmail.com</strong>.
        </p>
      </div>

      <div style="margin-top: 2rem; display: flex; justify-content: space-between;">
        <a class="back-link" href="/">← Back to ImageSizeChanger</a>
        <a class="back-link" href="/guides">Explore Guides →</a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>