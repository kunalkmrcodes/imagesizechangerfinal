---
import "../styles/global.css";
---

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Terms of Use — ImageSizeChanger</title>

  <meta
    name="description"
    content="Read the Terms of Use for ImageSizeChanger."
  />

  <link
    rel="icon"
    type="image/png"
    href="/favicon.png"
  />

</head>


<body>


<header class="site-header">

  <div class="container nav-inner">


    <a class="brand" href="/">

      <img
        src="/favicon.png"
        alt=""
        class="brand-icon"
      />

      <span>
        ImageSizeChanger
      </span>

    </a>



    <nav class="nav-links">

      <a href="/#resize">
        Resize
      </a>

      <a href="/#features">
        Features
      </a>

      <a href="/#faq">
        FAQ
      </a>

    </nav>



    <a
      class="nav-cta"
      href="/#resize"
