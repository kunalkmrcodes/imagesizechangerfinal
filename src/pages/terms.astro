---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.imagesizechanger.info/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Terms of Use",
      "item": "https://www.imagesizechanger.info/terms"
    }
  ]
};
---

<Layout
  title="Terms of Use — ImageSizeChanger"
  description="Read the Terms of Use for ImageSizeChanger regarding appropriate use, service availability, user responsibilities, and content disclaimers."
  structuredData={breadcrumbSchema}
>
  <Header />

  <main class="legal-page">
    <div class="container narrow-container">

      <div class="status-pill">
        <span class="status-dot"></span>
        Terms of Use
      </div>

      <h1>Terms of Use</h1>

      <p class="lead">
        Welcome to ImageSizeChanger. By accessing or using our website and browser tools, you agree to comply with and be bound by the following Terms of Use.
      </p>

      <div class="legal-card">
        <h2>1. Acceptance of Terms</h2>
        <p>
          By using ImageSizeChanger, you confirm that you have read, understood, and agreed to these Terms of Use. If you do not agree to these terms, please do not use our website or online tools.
        </p>

        <h2>2. Description of Service</h2>
        <p>
          ImageSizeChanger provides web-based utility tools that allow users to resize pixel dimensions, compress file sizes, and convert file formats for digital image files directly within their web browser.
        </p>

        <h2>3. Appropriate Use</h2>
        <p>
          You agree to use ImageSizeChanger only for lawful purposes. You must not attempt to disrupt site functionality, introduce malicious code, probe site infrastructure vulnerability, or automatedly abuse the website.
        </p>

        <h2>4. User Content & File Responsibility</h2>
        <p>
          You retain full ownership and responsibility for any image files you select for processing using ImageSizeChanger. You represent and warrant that you own or have obtained all necessary licenses, permissions, and rights to use and process any files you upload or drop into the tool interface.
        </p>

        <h2>5. In-Browser Local Processing</h2>
        <p>
          Image processing occurs locally within your web browser using client-side JavaScript APIs. Your image files are not stored on or uploaded to our servers.
        </p>

        <h2>6. Intellectual Property</h2>
        <p>
          All content on ImageSizeChanger—including software code, text documentation, articles, guides, visual designs, logos, and UI layout—is protected by applicable copyright, trademark, and intellectual property laws.
        </p>

        <h2>7. Service Availability & Output Accuracy</h2>
        <p>
          While we strive to maintain 99.9% site uptime and accurate image processing calculations, ImageSizeChanger is provided on an "AS IS" and "AS AVAILABLE" basis. We do not guarantee uninterrupted access or that output file sizes will satisfy every external third-party system's upload requirements.
        </p>

        <h2>8. Limitation of Liability</h2>
        <p>
          To the fullest extent permitted by applicable law, ImageSizeChanger and its operators shall not be liable for any indirect, incidental, special, consequential, or punitive damages resulting from your use of or inability to use the website.
        </p>

        <h2>9. Changes to Terms</h2>
        <p>
          We reserve the right to revise or update these Terms of Use at any time. Continued use of ImageSizeChanger following updates constitutes acceptance of the modified terms.
        </p>

        <h2>10. Contact Information</h2>
        <p>
          If you have questions regarding these Terms of Use, please contact us via email at <strong>imagesizechanger@gmail.com</strong> or visit our <a href="/contact">Contact Page</a>.
        </p>

        <p class="updated">Last updated: August 2026</p>
      </div>

      <a class="back-link" href="/">← Back to ImageSizeChanger</a>
    </div>
  </main>

  <Footer />
</Layout>