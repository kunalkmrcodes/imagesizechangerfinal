                    type="button"
                    data-width="1080"
                    data-height="1080"
                  >
                    <strong>Instagram</strong>
                    <span>1080 × 1080</span>
                  </button>

                  <button
                    class="preset"
                    type="button"
                    data-width="1200"
                    data-height="630"
                  >
                    <strong>Facebook</strong>
                    <span>1200 × 630</span>
                  </button>

                  <button
                    class="preset"
                    type="button"
                    data-width="1280"
                    data-height="720"
                  >
                    <strong>YouTube</strong>
                    <span>1280 × 720</span>
                  </button>

                  <button
                    class="preset"
                    type="button"
                    data-width="1500"
                    data-height="500"
                  >
                    <strong>Twitter / X</strong>
                    <span>1500 × 500</span>
                  </button>

                  <button
                    class="preset"
