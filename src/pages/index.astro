              </div>

            </div>

          </div>
        </div>
      </section>


      <!-- FEATURES -->
      <section
        id="features"
        class="content-section"
      >
        <div class="container">

          <div class="section-label">
            WHY USE IT
          </div>

          <div class="section-heading">

            <h2>
              Resize and compress without uploading.
            </h2>

            <p>
              Everything happens directly in your browser.
              Your images don't need to leave your device.
            </p>

          </div>


          <div class="feature-grid">

            <article class="feature-card">
              <div class="feature-number">
                01
              </div>

              <h3>
                100% browser-based
              </h3>

              <p>
                Images are processed locally on your
                device instead of being uploaded to a server.
              </p>
            </article>


            <article class="feature-card">
              <div class="feature-number">
                02
              </div>

              <h3>
                Precise resizing
              </h3>

              <p>
                Set exact width and height values or
                preserve the original aspect ratio.
              </p>
            </article>


            <article class="feature-card">
              <div class="feature-number">
                03
              </div>

              <h3>
                Target file size
              </h3>

              <p>
                Set a target such as 40 KB or 1 MB
                and automatically compress your image.
              </p>
            </article>


            <article class="feature-card">
              <div class="feature-number">
                04
              </div>

              <h3>
                Batch processing
              </h3>

