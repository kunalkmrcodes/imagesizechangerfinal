---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>ImageSizeChanger — Resize & Compress Images Online</title>

    <meta
      name="description"
      content="Resize and compress images online for free. Change dimensions, reduce file size and convert JPG, PNG and WebP images directly in your browser."
    />

    <meta
      name="theme-color"
      content="#07080d"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <link
      rel="apple-touch-icon"
      href="/favicon.png"
    />
  </head>

  <body>

    <!-- HEADER -->
    <header class="site-header">
      <div class="container nav-inner">

        <a
          class="brand"
          href="/"
          aria-label="ImageSizeChanger home"
        >
          <img
            src="/favicon.png"
            alt=""
            class="brand-icon"
          />

          <span>ImageSizeChanger</span>
        </a>

        <nav
          class="nav-links"
          aria-label="Main navigation"
        >
          <a href="/#resize">Resize</a>
          <a href="/#features">Features</a>
          <a href="/#faq">FAQ</a>
        </nav>

        <a
          class="nav-cta"
          href="#resize"
        >
          Start resizing
        </a>

        <details class="mobile-nav">
          <summary aria-label="Open navigation menu">
            <span></span>
            <span></span>
            <span></span>
          </summary>

          <div class="mobile-menu">
            <a href="/#resize">Resize</a>
            <a href="/#features">Features</a>
            <a href="/#faq">FAQ</a>

            <a
              class="mobile-menu-cta"
              href="#resize"
            >
              Start resizing
            </a>
          </div>
        </details>

      </div>
    </header>

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="container hero-inner">

          <div class="status-pill">
            <span class="status-dot"></span>
            Fast · Private · Browser-based
          </div>

          <h1>
            Resize your
            <br />
            images.
            <span>
              Exactly how you want.
            </span>
          </h1>

          <p class="hero-description">
            Change image dimensions, quality and format
            in seconds. No account. No complicated
            software. Your images stay on your device.
          </p>

          <div class="hero-tags">
            <span>JPG</span>
            <span>PNG</span>
            <span>WebP</span>
            <span>Batch ready</span>
          </div>

        </div>
      </section>


      <!-- WORKSPACE -->
      <section
        id="resize"
        class="workspace-section"
      >
        <div class="container">

          <div class="section-label">
            IMAGE RESIZER
          </div>

          <div class="workspace">

            <!-- UPLOAD -->
            <div
              class="drop-zone"
              id="dropZone"
              tabindex="0"
              role="button"
              aria-label="Upload images"
            >

              <input
                id="fileInput"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif,image/bmp"
                multiple
                hidden
              />

              <div class="upload-icon">
                <span>↑</span>
              </div>

              <h2>
                Drop your images here
              </h2>

              <p class="upload-action">
                <span>or</span>

                <button
                  id="browseButton"
                  type="button"
                  class="text-button"
                >
                  browse files
                </button>
              </p>

              <small>
                JPG, PNG, WebP, GIF or BMP ·
                Multiple files supported
              </small>

            </div>


            <!-- FILE LIST -->
            <div
              id="fileList"
              class="file-list"
              hidden
            ></div>


            <!-- CONTROLS -->
            <div
              id="controls"
              class="controls"
              hidden
            >

              <!-- RESIZE -->
              <div class="control-section">

                <div class="control-heading">

                  <div>
                    <span class="control-eyebrow">
                      RESIZE
                    </span>

                    <h2>
                      Output size
                    </h2>
                  </div>

                  <div class="unit-toggle">

                    <button
                      type="button"
                      class="unit-button active"
                      data-unit="pixels"
                    >
                      Pixels
                    </button>

                    <button
                      type="button"
                      class="unit-button"
                      data-unit="percent"
                    >
                      Percent
                    </button>

                  </div>

                </div>


                <div class="dimension-grid">

                  <label class="field">
                    <span>Width</span>

                    <div class="input-wrap">
                      <input
                        id="widthInput"
                        type="number"
                        min="1"
                        max="10000"
                      />

                      <span id="widthUnit">
                        px
                      </span>
                    </div>
                  </label>


                  <button
                    id="lockButton"
                    type="button"
                    class="lock-button active"
                    aria-pressed="true"
                    title="Lock aspect ratio"
                  >
                    🔗
                  </button>


                  <label class="field">
                    <span>Height</span>

                    <div class="input-wrap">
                      <input
                        id="heightInput"
                        type="number"
                        min="1"
                        max="10000"
                      />

                      <span id="heightUnit">
                        px
