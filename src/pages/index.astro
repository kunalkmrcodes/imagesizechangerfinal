                    </div>

                  </label>


                  <p class="target-help">
                    Try <strong>40 KB</strong> for a small image
                    or <strong>1 MB</strong> for a larger image.
                    The browser will automatically adjust compression.
                  </p>

                </div>


                <!-- FORMAT -->
                <div class="format-area">

                  <span class="control-eyebrow">
                    OUTPUT FORMAT
                  </span>

                  <div class="format-grid">

                    <button
                      class="format-button active"
                      type="button"
                      data-format="image/jpeg"
                    >
                      <strong>JPG</strong>

                      <span>
                        Best for photos
                      </span>
                    </button>


                    <button
                      class="format-button"
                      type="button"
                      data-format="image/png"
                    >
                      <strong>PNG</strong>

                      <span>
                        Lossless quality
                      </span>
                    </button>


                    <button
                      class="format-button"
                      type="button"
                      data-format="image/webp"
                    >
                      <strong>WebP</strong>

                      <span>
                        Modern & efficient
                      </span>
                    </button>

                  </div>

                </div>


                <div class="compression-info">

                  <div class="compression-info-item">
                    <strong>Resize</strong>

                    <span>
                      Change dimensions
                    </span>
                  </div>

                  <div class="compression-info-item">
                    <strong>Target size</strong>

                    <span>
                      KB or MB
                    </span>
                  </div>

                  <div class="compression-info-item">
                    <strong>Format</strong>

                    <span>
                      JPG · PNG · WebP
                    </span>
                  </div>

                </div>

              </div>


              <!-- ACTION -->
              <div class="action-area">

                <div>
                  <strong id="selectedCount">
                    0 images selected
                  </strong>

                  <span>
                    Resize and compress locally
                    in your browser.
                  </span>
                </div>

                <button
                  id="resizeButton"
                  type="button"
                  class="primary-button"
                >
                  Resize & compress
                  <span>↗</span>
                </button>

              </div>


              <!-- PROGRESS -->
              <div
                id="progressArea"
                class="progress-area"
                hidden
              >

                <div class="progress-track">
                  <div
                    id="progressBar"
                    class="progress-bar"
