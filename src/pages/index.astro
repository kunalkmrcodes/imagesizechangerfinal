---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "ImageSizeChanger — Free Online Image Size Changer",
  "url": "https://www.imagesizechanger.info",
  "description": "Free online image size changer. Resize image dimensions in pixels or percentage, lock aspect ratios to avoid distortion, compress file size in KB or MB, and convert JPG, PNG, and WebP directly in your browser.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ImageSizeChanger",
  "url": "https://www.imagesizechanger.info",
  "logo": "https://www.imagesizechanger.info/favicon.png"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is an image size changer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An image size changer is an online tool that adjusts the width and height (pixel dimensions) of a digital image. It enables you to scale photos for web pages, social media, document uploads, or emails without distortion."
      }
    },
    {
      "@type": "Question",
      "name": "How do I resize an image without distorting it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Keep the aspect ratio lock enabled (🔗). When you enter a new width or height, the other dimension automatically recalculates proportionally, ensuring your photo never looks stretched or squashed."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between image size and image file size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Image size refers to pixel dimensions (such as 1920 × 1080 px) which describe how wide and tall the image displays on screen. Image file size refers to digital storage weight in Kilobytes (KB) or Megabytes (MB), which affects upload time and download bandwidth."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to any server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. All image resizing, compression, and conversion happens entirely in your web browser using HTML5 Canvas technology. Your files remain on your device and are never transmitted to our servers."
      }
    },
    {
      "@type": "Question",
      "name": "What image formats are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can upload JPG, JPEG, PNG, WebP, GIF, and BMP files. Output files can be exported as JPG, PNG, or WebP."
      }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Resize an Image Online",
  "description": "Step-by-step instructions for resizing image dimensions in pixels or percentage and downloading optimized files.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "1. Upload Your Image",
      "text": "Drag and drop your JPG, PNG, WebP, GIF, or BMP image into the workspace dropzone or click browse files."
    },
    {
      "@type": "HowToStep",
      "name": "2. Set Width and Height",
      "text": "Enter your desired dimensions in pixels or percentage, or pick a preset like Instagram 1080x1080 or YouTube 1280x720. Keep the aspect ratio lock active to prevent distortion."
    },
    {
      "@type": "HowToStep",
      "name": "3. Choose Export Settings & Download",
      "text": "Select your output format (JPG, PNG, or WebP), optionally enter a target file size in KB, and click the Resize button to download your image."
    }
  ]
};
---

<Layout
  title="Free Online Image Size Changer — Resize Dimensions & Compress Images"
  description="Free online image size changer. Resize image dimensions in pixels or percentage, lock aspect ratios to avoid distortion, compress file size in KB or MB, and convert JPG, PNG, and WebP directly in your browser."
  structuredData={[webAppSchema, organizationSchema, faqSchema, howToSchema]}
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="container hero-inner">
        <div class="status-pill">
          <span class="status-dot"></span>
          100% In-Browser · Fast & Private · No Signup
        </div>

        <h1>
          Free Online Image Size Changer
        </h1>

        <p class="hero-description">
          Easily resize image dimensions in pixels or percentages, lock aspect ratios to prevent distortion, compress file sizes to target KB limits, and convert formats directly inside your browser. No file uploads, no software installation, and no account needed.
        </p>

        <div class="hero-tags">
          <span>JPG / JPEG</span>
          <span>PNG</span>
          <span>WebP</span>
          <span>GIF / BMP</span>
          <span>Batch Resizing</span>
        </div>
      </div>
    </section>

    <!-- WORKSPACE TOOL -->
    <section id="resize" class="workspace-section">
      <div class="container">
        <div class="section-label">IMAGE RESIZER TOOL</div>
        <div class="workspace">

          <!-- UPLOAD -->
          <div class="drop-zone" id="dropZone" tabindex="0" role="button" aria-label="Upload images">
            <input id="fileInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp" multiple hidden />
            <div class="upload-icon"><span>↑</span></div>
            <h2>Drop your images here</h2>
            <p class="upload-action">
              <span>or</span>
              <button id="browseButton" type="button" class="text-button">browse files</button>
            </p>
            <small>JPG, PNG, WebP, GIF, or BMP · Multiple files supported · Processed locally on your device</small>
          </div>

          <!-- FILE LIST -->
          <div id="fileList" class="file-list" hidden></div>

          <!-- CONTROLS -->
          <div id="controls" class="controls" hidden>
            <div class="control-section">
              <div class="control-heading">
                <div>
                  <span class="control-eyebrow">RESIZE</span>
                  <h2>Output size</h2>
                </div>
                <div class="unit-toggle">
                  <button type="button" class="unit-button active" data-unit="pixels">Pixels</button>
                  <button type="button" class="unit-button" data-unit="percent">Percent</button>
                </div>
              </div>

              <div class="dimension-grid">
                <label class="field">
                  <span>Width</span>
                  <div class="input-wrap">
                    <input id="widthInput" type="number" min="1" max="10000" />
                    <span id="widthUnit">px</span>
                  </div>
                </label>

                <button id="lockButton" type="button" class="lock-button active" aria-pressed="true" title="Lock aspect ratio">🔗</button>

                <label class="field">
                  <span>Height</span>
                  <div class="input-wrap">
                    <input id="heightInput" type="number" min="1" max="10000" />
                    <span id="heightUnit">px</span>
                  </div>
                </label>
              </div>
              <p id="originalSize" class="dimension-note">Original size will appear here.</p>
            </div>

            <!-- PRESETS -->
            <div class="control-section">
              <span class="control-eyebrow">PRESETS</span>
              <h2>Popular sizes</h2>
              <div class="preset-grid">
                <button class="preset" type="button" data-width="1080" data-height="1080"><strong>Instagram Post</strong><span>1080 × 1080 (1:1)</span></button>
                <button class="preset" type="button" data-width="1200" data-height="630"><strong>Facebook / OG</strong><span>1200 × 630 (1.91:1)</span></button>
                <button class="preset" type="button" data-width="1280" data-height="720"><strong>YouTube HD</strong><span>1280 × 720 (16:9)</span></button>
                <button class="preset" type="button" data-width="1500" data-height="500"><strong>Twitter / X Banner</strong><span>1500 × 500 (3:1)</span></button>
                <button class="preset" type="button" data-width="1200" data-height="675"><strong>Blog Graphic</strong><span>1200 × 675 (16:9)</span></button>
                <button class="preset" type="button" data-width="1920" data-height="1080"><strong>Full HD Desktop</strong><span>1920 × 1080 (16:9)</span></button>
              </div>
            </div>

            <!-- EXPORT SETTINGS -->
            <div class="control-section">
              <div class="control-heading">
                <div>
                  <span class="control-eyebrow">COMPRESS</span>
                  <h2>Export settings</h2>
                  <p class="compression-description">Optionally specify a maximum target file size.</p>
                </div>
              </div>

              <div class="target-size-box">
                <label class="field target-field">
                  <span>Target file size <em>(optional)</em></span>
                  <div class="target-size-row">
                    <input id="targetSizeInput" type="number" min="1" step="1" placeholder="e.g. 50" />
                    <select id="targetSizeUnit" aria-label="Target file size unit">
                      <option value="KB">KB</option>
                      <option value="MB">MB</option>
                    </select>
                  </div>
                </label>
              </div>

              <div class="format-area">
                <span class="control-eyebrow">OUTPUT FORMAT</span>
                <div class="format-grid">
                  <button class="format-button active" type="button" data-format="image/jpeg"><strong>JPG</strong><span>Best for photos</span></button>
                  <button class="format-button" type="button" data-format="image/png"><strong>PNG</strong><span>Crisp line art & transparency</span></button>
                  <button class="format-button" type="button" data-format="image/webp"><strong>WebP</strong><span>Modern & lightweight</span></button>
                </div>
              </div>
            </div>

            <div class="action-area">
              <div>
                <strong id="selectedCount">0 images selected</strong>
                <span>Processed locally in your browser memory.</span>
              </div>
              <button id="resizeButton" type="button" class="primary-button">
                Resize Image <span>↗</span>
              </button>
            </div>

            <div id="progressArea" class="progress-area" hidden>
              <div class="progress-track"><div id="progressBar" class="progress-bar"></div></div>
              <span id="progressText">Preparing...</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 1: WHAT IS AN IMAGE SIZE CHANGER? -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">OVERVIEW</div>
        <div class="section-heading">
          <h2>1. What Is an Image Size Changer?</h2>
          <p>Understanding how pixel dimensions, width, height, and resizing work.</p>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            An <strong>image size changer</strong> is a digital utility designed to adjust the physical pixel dimensions—the horizontal <strong>width</strong> and vertical <strong>height</strong>—of a digital raster image. Every digital photo, screenshot, and graphic is composed of an orderly grid of tiny color points called <strong>pixels (px)</strong>. For example, a standard Full HD image measuring <code>1920 × 1080</code> pixels contains 1,920 pixels horizontally and 1,080 pixels vertically, creating a total matrix of over 2.07 million individual pixels.
          </p>
          <p>
            Users resize images for a variety of practical everyday reasons:
          </p>
          <ul>
            <li><strong>Display Container Alignment:</strong> Ensuring web graphics precisely match content column widths (e.g. 800px or 1200px) so browsers don't have to scale oversized assets at runtime.</li>
            <li><strong>Social Media Specifications:</strong> Adjusting images to match recommended platform formats, such as square 1080 × 1080 posts for Instagram or 1200 × 630 preview cards for link sharing.</li>
            <li><strong>Upload Portals & Forms:</strong> Complying with strict pixel dimension limits on job portals, government exam forms, passport applications, and school registries.</li>
            <li><strong>Bandwidth & Storage Optimization:</strong> Downscaling oversized digital camera photos (which often exceed 6000 × 4000 pixels) to reduce unnecessary file weight before sending via email or hosting online.</li>
          </ul>
          <h3>Resizing vs. Cropping: What is the Difference?</h3>
          <p>
            It is helpful to distinguish between <strong>resizing</strong> and <strong>cropping</strong>:
          </p>
          <ul>
            <li><strong>Resizing:</strong> Scales the entire picture up or down so that 100% of the original visual content remains visible, but represented across a different number of total pixels.</li>
            <li><strong>Cropping:</strong> Cuts away outer sections or edges of the image to alter framing or change the aspect ratio, discarding part of the original image content.</li>
          </ul>
          <p>
            For more details on how dimensions relate to visual quality, explore our guide on <a href="/guides/change-image-dimensions/">How to Change Image Width and Height</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HOW TO RESIZE AN IMAGE (STEP-BY-STEP) -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">HOW-TO GUIDE</div>
        <div class="section-heading">
          <h2>2. How to Resize an Image: Step-by-Step</h2>
          <p>Follow this straightforward guide to resize any photo using our browser tool.</p>
        </div>

        <div class="feature-grid" style="margin-top: 1.5rem;">
          <article class="feature-card">
            <div class="feature-number">01</div>
            <h3>Upload or Drag Your Image</h3>
            <p>
              Click <strong>browse files</strong> or drag and drop your image file into the workspace area above. You can upload single or multiple JPG, PNG, WebP, GIF, or BMP files.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-number">02</div>
            <h3>Set Target Width or Height</h3>
            <p>
              Enter your desired output width or height in exact pixels (px) or switch to percentage scaling (e.g. 50% to halve the size). You can also click any of the social media presets.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-number">03</div>
            <h3>Verify Aspect Ratio Lock</h3>
            <p>
              Make sure the aspect ratio lock (🔗) is active. This automatically updates the complementary dimension proportionally so your subject never looks squished or stretched.
            </p>
          </article>

          <article class="feature-card">
            <div class="feature-number">04</div>
            <h3>Choose Format & Download</h3>
            <p>
              Select your preferred export format (JPG, PNG, or WebP), optionally specify a target file size in KB, and click <strong>Resize Image</strong> to save the file to your device.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 3: HOW TO RESIZE WITHOUT DISTORTING -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">PROPORTIONS & CLARITY</div>
        <div class="section-heading">
          <h2>3. How to Resize an Image Without Distorting It</h2>
          <p>Mastering aspect ratios to prevent unnatural stretching or squashing.</p>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            One of the most common mistakes in photo editing is <strong>aspect ratio distortion</strong>. An image's <strong>aspect ratio</strong> is the mathematical proportion between its width and its height:
          </p>
          <p style="background: var(--surface-input); padding: 1rem; border-left: 3px solid var(--accent); border-radius: 8px;">
            <code>Aspect Ratio = Width ÷ Height</code>
          </p>
          <p>
            For example, a photo that is <code>1600 px</code> wide and <code>900 px</code> tall has a <code>16:9</code> aspect ratio (<code>1600 / 900 ≈ 1.778</code>).
          </p>
          <h3>Why Stretching and Squashing Happen</h3>
          <p>
            If you want to reduce the width from <code>1600 px</code> down to <code>800 px</code> (halving the horizontal size), you must also reduce the height from <code>900 px</code> down to <code>450 px</code> (halving the vertical size).
          </p>
          <ul>
            <li><strong>Stretching:</strong> If you change the width to <code>1200 px</code> while leaving height at <code>400 px</code>, faces, buildings, and circles will look unnaturally wide and flattened.</li>
            <li><strong>Squashing:</strong> If you reduce width drastically without adjusting height, subjects will look tall and squeezed.</li>
          </ul>
          <h3>How Our Aspect Ratio Lock Protects You</h3>
          <p>
            On ImageSizeChanger, the aspect ratio lock is enabled by default. Whenever you change the width, the tool calculates:
          </p>
          <p style="background: var(--surface-input); padding: 1rem; border-left: 3px solid var(--accent); border-radius: 8px;">
            <code>New Height = Math.round(New Width ÷ Original Aspect Ratio)</code>
          </p>
          <p>
            This guarantees that your resized image retains the exact visual proportions of the original photograph. Learn more in our dedicated tutorial: <a href="/guides/image-aspect-ratio-guide/">Understanding Image Aspect Ratio</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 4: IMAGE SIZE VS IMAGE FILE SIZE -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">COMPARISON</div>
        <div class="section-heading">
          <h2>4. Image Size vs Image File Size: What's the Difference?</h2>
          <p>Distinguishing between pixel dimensions on screen and storage weight on disk.</p>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            Many people use the phrase "image size" interchangeably to describe two completely different technical concepts:
          </p>
          <div class="table-container">
            <table class="guide-table">
              <thead>
                <tr>
                  <th>Concept</th>
                  <th>Measurement Unit</th>
                  <th>What It Represents</th>
                  <th>Example</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Image Dimensions (Pixel Size)</strong></td>
                  <td>Pixels (width × height px)</td>
                  <td>The physical matrix of pixels that make up the image on a digital screen.</td>
                  <td><code>1920 × 1080 px</code> (Full HD)</td>
                </tr>
                <tr>
                  <td><strong>Image File Size (File Weight)</strong></td>
                  <td>Kilobytes (KB) or Megabytes (MB)</td>
                  <td>The amount of digital disk space or network bandwidth required to store or transmit the file.</td>
                  <td><code>420 KB</code> (0.42 MB)</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            A large pixel dimension does not always mean a massive file weight, and a compact pixel dimension does not guarantee a small file size. For example:
          </p>
          <ul>
            <li>A <code>1920 × 1080 px</code> screenshot saved as an uncompressed PNG with complex graphics might weigh <strong>2.8 MB</strong>.</li>
            <li>That same <code>1920 × 1080 px</code> scene compressed into modern WebP format might weigh only <strong>280 KB</strong>—a 90% reduction in file size with virtually indistinguishable visual sharpness!</li>
          </ul>
          <p>
            Read our in-depth analysis: <a href="/guides/image-size-vs-file-size/">Image Size vs File Size: What's the Difference?</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 5: SUPPORTED IMAGE FORMATS -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">FORMAT COMPATIBILITY</div>
        <div class="section-heading">
          <h2>5. Supported Image Formats</h2>
          <p>Overview of the image types you can upload, edit, and export with our tool.</p>
        </div>

        <div class="feature-grid" style="margin-top: 1.5rem;">
          <article class="feature-card">
            <h3>JPG / JPEG (.jpg, .jpeg)</h3>
            <p>
              The worldwide standard for photographic images. Uses efficient lossy compression algorithms to achieve compact file sizes while retaining rich gradients and realistic colors.
            </p>
          </article>

          <article class="feature-card">
            <h3>PNG (.png)</h3>
            <p>
              A lossless format that preserves razor-sharp text, geometric line art, icons, and alpha-channel transparent backgrounds without compression artifacts.
            </p>
          </article>

          <article class="feature-card">
            <h3>WebP (.webp)</h3>
            <p>
              A modern, high-efficiency web format developed by Google. Provides superior lossy and lossless compression, delivering 25–35% smaller file sizes than comparable JPGs and PNGs.
            </p>
          </article>

          <article class="feature-card">
            <h3>GIF (.gif) & BMP (.bmp)</h3>
            <p>
              Supported as input formats. You can upload static GIFs or uncompressed bitmap BMP files and easily convert and resize them into lightweight JPGs or WebPs.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 6: JPG VS PNG VS WEBP -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">COMPARISON TABLE</div>
        <div class="section-heading">
          <h2>6. JPG vs PNG vs WebP: Which Format Should You Choose?</h2>
          <p>Side-by-side evaluation of strengths, weaknesses, transparency, and use cases.</p>
        </div>

        <div class="table-container" style="margin-top: 1.5rem;">
          <table class="guide-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>JPG / JPEG</th>
                <th>PNG</th>
                <th>WebP</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Compression Type</strong></td>
                <td>Lossy</td>
                <td>Lossless</td>
                <td>Lossy & Lossless</td>
              </tr>
              <tr>
                <td><strong>Transparency Support</strong></td>
                <td>No (replaces with solid background)</td>
                <td>Yes (full alpha channel)</td>
                <td>Yes (full alpha channel)</td>
              </tr>
              <tr>
                <td><strong>Relative File Size</strong></td>
                <td>Small to Medium</td>
                <td>Medium to Large</td>
                <td>Very Small (25–35% smaller)</td>
              </tr>
              <tr>
                <td><strong>Best For</strong></td>
                <td>Photos, camera shots, colorful art</td>
                <td>Logos, UI badges, text screenshots</td>
                <td>Websites, blog graphics, mobile apps</td>
              </tr>
              <tr>
                <td><strong>Browser Support</strong></td>
                <td>Universal (100%)</td>
                <td>Universal (100%)</td>
                <td>Modern Browsers (97%+)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <h3>Practical Format Selection Advice</h3>
          <ul>
            <li><strong>Choose JPG</strong> if you are preparing photographic portraits, landscape photos, or product photography where small file size is crucial and transparency is not needed.</li>
            <li><strong>Choose PNG</strong> if you are exporting transparent logos, UI mockups, infographics with small text, or icons where crisp sharp edges are mandatory.</li>
            <li><strong>Choose WebP</strong> if you are publishing images to a website, blog, or online storefront to achieve the fastest possible loading speeds without sacrificing visual quality.</li>
          </ul>
          <p>
            For a deep technical breakdown, read our comprehensive guide: <a href="/guides/jpg-vs-png-vs-webp/">JPG vs PNG vs WebP: Which Image Format Should You Use?</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 7: WHEN SHOULD YOU RESIZE AN IMAGE? -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">USE CASES</div>
        <div class="section-heading">
          <h2>7. When Should You Resize an Image?</h2>
          <p>Practical real-world scenarios where dimension and file size resizing are essential.</p>
        </div>

        <div class="feature-grid" style="margin-top: 1.5rem;">
          <article class="feature-card">
            <h3>1. Website & Blog Optimization</h3>
            <p>
              Serving 4000px raw photos inside a 800px blog column slows down page loading, wastes user mobile data, and hurts search rankings. Resize images to match display widths. Explore our guide on <a href="/guides/resize-images-for-websites/">How to Resize Images for Websites</a>.
            </p>
          </article>

          <article class="feature-card">
            <h3>2. Social Media Banners & Posts</h3>
            <p>
              Social networks automatically compress and crop oversized graphics. By sizing your images beforehand (e.g. 1080 × 1080 for Instagram, 1200 × 630 for Facebook), you control the framing and sharpness. See <a href="/guides/social-media-image-sizes/">Common Social Media Image Sizes</a>.
            </p>
          </article>

          <article class="feature-card">
            <h3>3. Job & Passport Application Portals</h3>
            <p>
              Government registries and job portals frequently enforce strict upload rules (e.g., photo must be exactly 300 × 300 px and under 50 KB). ImageSizeChanger lets you dial in both exact pixels and target file sizes.
            </p>
          </article>

          <article class="feature-card">
            <h3>4. Email Attachments & Newsletters</h3>
            <p>
              Email clients often block or reject messages with large attachments. Resizing multiple photos before sending ensures your email arrives promptly and renders smoothly on mobile.
            </p>
          </article>

          <article class="feature-card">
            <h3>5. Digital Documents & PDFs</h3>
            <p>
              Embedding five 10 MB camera photos into a Word document or presentation can swell the file to 50 MB, making it difficult to email. Resizing photos first keeps documents compact and fast to open.
            </p>
          </article>

          <article class="feature-card">
            <h3>6. Local Storage Management</h3>
            <p>
              Archiving high-resolution digital camera photos can rapidly consume phone or hard drive storage. Downscaling non-essential reference photos saves gigabytes of disk space.
            </p>
          </article>
        </div>
      </div>
    </section>

