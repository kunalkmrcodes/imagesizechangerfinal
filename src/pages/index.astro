---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "ImageSizeChanger",
  "url": "https://www.imagesizechanger.info",
  "description": "Resize and compress images online for free. Change dimensions, reduce file size and convert JPG, PNG and WebP images directly in your browser.",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ImageSizeChanger",
  "url": "https://www.imagesizechanger.info",
  "logo": "https://www.imagesizechanger.info/favicon.png"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I resize an image?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Upload your image file, specify your target width or height in pixels or percentage, keep aspect ratio locked to prevent distortion, choose your output format, and click Resize & compress."
      }
    },
    {
      "@type": "Question",
      "name": "Can I resize an image without changing its proportions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Keep the aspect-ratio lock enabled while entering a new width or height. The tool automatically calculates the missing dimension proportionally."
      }
    },
    {
      "@type": "Question",
      "name": "What does aspect ratio mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aspect ratio is the proportional relationship between an image's width and height, such as 16:9 for widescreen monitors or 1:1 for square social posts."
      }
    },
    {
      "@type": "Question",
      "name": "Does resizing reduce image quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Downscaling generally preserves good visual sharpness when the source image has sufficient resolution and appropriate processing settings are used. Upscaling a small image requires software to estimate missing pixels and can cause blurriness."
      }
    },
    {
      "@type": "Question",
      "name": "Can I make an image larger?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can increase pixel dimensions, but enlarging very small images excessively will make them appear soft or pixelated because missing detail cannot be technically recreated."
      }
    },
    {
      "@type": "Question",
      "name": "How can I reduce an image's file size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can reduce file size by downscaling pixel dimensions, adjusting quality compression factor, converting to modern WebP format, or specifying a target file size in KB or MB."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between JPG, PNG and WebP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JPG uses lossy compression best for photos; PNG uses lossless compression supporting transparency; WebP is a modern web codec that produces smaller files at comparable visual quality."
      }
    },
    {
      "@type": "Question",
      "name": "Can I process multiple images at once?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Select or drag multiple supported image files into the workspace to batch process them together."
      }
    },
    {
      "@type": "Question",
      "name": "Can I target a specific file size in KB or MB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Enter a target like 50 KB or 1 MB. The tool's search algorithm automatically adjusts JPEG or WebP compression to get as close as possible under your target limit."
      }
    },
    {
      "@type": "Question",
      "name": "Are my images uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. All image processing occurs locally inside your web browser using HTML5 Canvas APIs. Your images are never sent to or stored on our servers."
      }
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Resize and Compress Images Online",
  "description": "Step-by-step guide to resizing dimensions, reducing file size in KB or MB, and converting image formats directly in your web browser.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Upload Images",
      "text": "Drag and drop single or multiple image files into the workspace area or click browse files."
    },
    {
      "@type": "HowToStep",
      "name": "Configure Output Dimensions & Target Size",
      "text": "Enter custom width and height in pixels or percentage, or pick a preset. Set an optional target file size in KB or MB."
    },
    {
      "@type": "HowToStep",
      "name": "Select Output Format & Export",
      "text": "Choose between JPG, PNG, or WebP format and click Resize & compress to save your processed images."
    }
  ]
};
---

<Layout
  title="ImageSizeChanger — Resize & Compress Images Online"
  description="Resize and compress images online for free. Change dimensions, reduce file size and convert JPG, PNG and WebP images directly in your browser."
  structuredData={[webAppSchema, organizationSchema, faqSchema, howToSchema]}
>
  <Header />

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="container hero-inner">
        <div class="status-pill">
          <span class="status-dot"></span>
          Fast · Private · Browser-based
        </div>

        <h1>
          Resize your
          <br />
          images.
          <span>Exactly how you want.</span>
        </h1>

        <p class="hero-description">
          Change image dimensions, quality and format in seconds. No account. No complicated software. Your images stay on your device.
        </p>

        <div class="hero-tags">
          <span>JPG</span>
          <span>PNG</span>
          <span>WebP</span>
          <span>Batch ready</span>
        </div>
      </div>
    </section>

    <!-- WORKSPACE TOOL -->
    <section id="resize" class="workspace-section">
      <div class="container">
        <div class="section-label">IMAGE RESIZER TOOL</div>
        <div class="workspace">

          <!-- UPLOAD -->
          <div class="drop-zone" id="dropZone" tabindex="0" role="button" aria-label="Upload images">
            <input id="fileInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp" multiple hidden />
            <div class="upload-icon"><span>↑</span></div>
            <h2>Drop your images here</h2>
            <p class="upload-action">
              <span>or</span>
              <button id="browseButton" type="button" class="text-button">browse files</button>
            </p>
            <small>JPG, PNG, WebP, GIF or BMP · Multiple files supported</small>
          </div>

          <!-- FILE LIST -->
          <div id="fileList" class="file-list" hidden></div>

          <!-- CONTROLS -->
          <div id="controls" class="controls" hidden>
            <div class="control-section">
              <div class="control-heading">
                <div>
                  <span class="control-eyebrow">RESIZE</span>
                  <h2>Output size</h2>
                </div>
                <div class="unit-toggle">
                  <button type="button" class="unit-button active" data-unit="pixels">Pixels</button>
                  <button type="button" class="unit-button" data-unit="percent">Percent</button>
                </div>
              </div>

              <div class="dimension-grid">
                <label class="field">
                  <span>Width</span>
                  <div class="input-wrap">
                    <input id="widthInput" type="number" min="1" max="10000" />
                    <span id="widthUnit">px</span>
                  </div>
                </label>

                <button id="lockButton" type="button" class="lock-button active" aria-pressed="true" title="Lock aspect ratio">🔗</button>

                <label class="field">
                  <span>Height</span>
                  <div class="input-wrap">
                    <input id="heightInput" type="number" min="1" max="10000" />
                    <span id="heightUnit">px</span>
                  </div>
                </label>
              </div>
              <p id="originalSize" class="dimension-note">Original size will appear here.</p>
            </div>

            <!-- PRESETS -->
            <div class="control-section">
              <span class="control-eyebrow">PRESETS</span>
              <h2>Popular sizes</h2>
              <div class="preset-grid">
                <button class="preset" type="button" data-width="1080" data-height="1080"><strong>Instagram</strong><span>1080 × 1080</span></button>
                <button class="preset" type="button" data-width="1200" data-height="630"><strong>Facebook</strong><span>1200 × 630</span></button>
                <button class="preset" type="button" data-width="1280" data-height="720"><strong>YouTube</strong><span>1280 × 720</span></button>
                <button class="preset" type="button" data-width="1500" data-height="500"><strong>Twitter / X</strong><span>1500 × 500</span></button>
                <button class="preset" type="button" data-width="1200" data-height="675"><strong>Blog image</strong><span>1200 × 675</span></button>
                <button class="preset" type="button" data-width="1920" data-height="1080"><strong>Full HD</strong><span>1920 × 1080</span></button>
              </div>
            </div>

            <!-- EXPORT SETTINGS -->
            <div class="control-section">
              <div class="control-heading">
                <div>
                  <span class="control-eyebrow">COMPRESS</span>
                  <h2>Export settings</h2>
                  <p class="compression-description">Set an optional maximum file size.</p>
                </div>
              </div>

              <div class="target-size-box">
                <label class="field target-field">
                  <span>Target file size <em>(optional)</em></span>
                  <div class="target-size-row">
                    <input id="targetSizeInput" type="number" min="1" step="1" placeholder="40" />
                    <select id="targetSizeUnit" aria-label="Target file size unit">
                      <option value="KB">KB</option>
                      <option value="MB">MB</option>
                    </select>
                  </div>
                </label>
              </div>

              <div class="format-area">
                <span class="control-eyebrow">OUTPUT FORMAT</span>
                <div class="format-grid">
                  <button class="format-button active" type="button" data-format="image/jpeg"><strong>JPG</strong><span>Best for photos</span></button>
                  <button class="format-button" type="button" data-format="image/png"><strong>PNG</strong><span>Lossless quality</span></button>
                  <button class="format-button" type="button" data-format="image/webp"><strong>WebP</strong><span>Modern & efficient</span></button>
                </div>
              </div>
            </div>

            <div class="action-area">
              <div>
                <strong id="selectedCount">0 images selected</strong>
                <span>Resize locally in your browser.</span>
              </div>
              <button id="resizeButton" type="button" class="primary-button">
                Resize image <span>↗</span>
              </button>
            </div>

            <div id="progressArea" class="progress-area" hidden>
              <div class="progress-track"><div id="progressBar" class="progress-bar"></div></div>
              <span id="progressText">Preparing...</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION: TOOL FEATURES -->
    <section id="features" class="content-section">
      <div class="container">
        <div class="section-label">FEATURES</div>
        <div class="section-heading">
          <h2>Core Tool Features</h2>
          <p>Explore the full range of client-side image editing capabilities.</p>
        </div>

        <div class="feature-grid" style="margin-top: 1.5rem;">
          <article class="feature-card">
            <h3>Pixel & Percent Scaling</h3>
            <p>Resize images by entering custom width and height in exact pixels or percentage values.</p>
          </article>
          <article class="feature-card">
            <h3>Aspect Ratio Protection</h3>
            <p>Lock aspect ratio with one click to scale dimensions proportionally without stretching or distorting images.</p>
          </article>
          <article class="feature-card">
            <h3>Optional Target File Size</h3>
            <p>Specify a target size in KB or MB to compress images to fit email and online portal upload limits.</p>
          </article>
          <article class="feature-card">
            <h3>Format Conversion</h3>
            <p>Convert images between JPG, PNG and WebP formats directly in your browser.</p>
          </article>
          <article class="feature-card">
            <h3>Batch File Processing</h3>
            <p>Upload and process multiple images simultaneously to save time during bulk resizing tasks.</p>
          </article>
          <article class="feature-card">
            <h3>Dimension Presets</h3>
            <p>Apply quick preset buttons for standard social media graphics and common display sizes.</p>
          </article>
          <article class="feature-card">
            <h3>Browser-Based Privacy</h3>
            <p>All processing runs locally in your web browser using HTML5 Canvas—your files are not uploaded to our server.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION: WHAT DOES IMAGE RESIZING MEAN? -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">FUNDAMENTALS</div>
        <div class="section-heading">
          <h2>What Does Image Resizing Mean?</h2>
          <p>Learn how pixel dimensions and file weight interact during image editing.</p>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            Image resizing refers to changing the physical <strong>pixel dimensions</strong> of a digital image—its horizontal width and vertical height measured in pixels (px).
          </p>
          <p>
            When you scale down an image (for instance, from <code>4000 × 3000</code> pixels down to <code>1200 × 900</code> pixels), your computer reorganizes pixel data across a smaller matrix. Because fewer total pixels must be stored, the overall file weight in kilobytes (KB) or megabytes (MB) drops significantly.
          </p>
          <p>
            It is important to recognize that increasing pixel dimensions (upscaling) does not automatically increase image clarity or recreate missing fine detail. If you attempt to stretch a small <code>200 × 200</code> pixel thumbnail up to <code>2000 × 2000</code> pixels, software must fill in unknown pixels by averaging surrounding colors, resulting in soft or blurry visual edges.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION: HOW TO RESIZE AN IMAGE -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">TUTORIAL</div>
        <div class="section-heading">
          <h2>How to Resize an Image: Step-by-Step</h2>
        </div>

        <div class="feature-grid">
          <article class="feature-card">
            <div class="feature-number">01</div>
            <h3>1. Select your files</h3>
            <p>Drag and drop your images into the dropzone or click browse files. Select single or multiple photos.</p>
          </article>
          <article class="feature-card">
            <div class="feature-number">02</div>
            <h3>2. Enter width & height</h3>
            <p>Type your desired output width or height in pixels or percentage. Or pick a social preset.</p>
          </article>
          <article class="feature-card">
            <div class="feature-number">03</div>
            <h3>3. Lock aspect ratio</h3>
            <p>Keep aspect ratio locked to preserve proportions and prevent distorted or stretched subjects.</p>
          </article>
          <article class="feature-card">
            <div class="feature-number">04</div>
            <h3>4. Export & Save</h3>
            <p>Pick your output format (JPG, PNG, WebP) and click Resize & compress to save your processed files.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION: HOW TO RESIZE WITHOUT LOSING QUALITY -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">SHARPNESS TIPS</div>
        <div class="section-heading">
          <h2>How to Resize an Image Without Losing Quality</h2>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            While technically all raster downscaling alters original pixel data, you can preserve maximum visual sharpness by following these practical rules:
          </p>
          <ul>
            <li><strong>Always Lock Aspect Ratio:</strong> Unlocked dimensions force unequal scaling, distorting text and subject shapes.</li>
            <li><strong>Avoid Excessive Upscaling:</strong> Avoid enlarging very small images significantly. Always resize from original high-resolution master files.</li>
            <li><strong>Match Container Dimensions:</strong> Resize graphics to match the actual display container (e.g. 1200px width for blog content) rather than oversized dimensions.</li>
            <li><strong>Choose the Right Format:</strong> Use PNG for graphics requiring crisp line art or transparency; use WebP or JPG for rich color photographs.</li>
            <li><strong>Avoid Repeated JPEG Re-saving:</strong> Re-compressing JPEG files multiple times causes cumulative lossy artifacts. Edit from raw or PNG files and export JPEG once as final output.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- SECTION: IMAGE SIZE VS FILE SIZE -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">COMPARISON</div>
        <div class="section-heading">
          <h2>Image Size vs File Size: Understanding the Difference</h2>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            A common source of confusion is the difference between <strong>image dimensions</strong> and <strong>file weight</strong>:
          </p>
          <ul>
            <li><strong>Image Dimensions (Pixel Size):</strong> Measured in pixels (e.g. <code>1920 × 1080 pixels</code>). This describes screen real estate and proportion.</li>
            <li><strong>File Size (Storage Weight):</strong> Measured in Kilobytes (KB) or Megabytes (MB) (e.g. <code>450 KB</code>). This describes hard drive or network bandwidth consumption.</li>
          </ul>
          <p>
            Because of file encoding differences, a <code>1920 × 1080</code> pixel uncompressed PNG graphic containing high detail might weigh <strong>2.5 MB</strong>, while a <code>1920 × 1080</code> pixel WebP photograph might weigh only <strong>250 KB</strong>!
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION: COMMON IMAGE DIMENSIONS -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">REFERENCE TABLE</div>
        <div class="section-heading">
          <h2>Common Image Dimensions Reference</h2>
          <p>Recommended standard dimensions for digital displays and social sharing.</p>
        </div>

        <div class="table-container">
          <table class="guide-table">
            <thead>
              <tr>
                <th>Dimension (px)</th>
                <th>Common Name / Format</th>
                <th>Typical Application</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1920 × 1080</td>
                <td>Full HD (16:9)</td>
                <td>Desktop wallpapers, hero banners, YouTube video thumbnails</td>
              </tr>
              <tr>
                <td>1280 × 720</td>
                <td>HD (16:9)</td>
                <td>Standard blog content photos, video thumbnails</td>
              </tr>
              <tr>
                <td>1080 × 1080</td>
                <td>Square (1:1)</td>
                <td>Social media feed posts, profile avatars, product thumbnails</td>
              </tr>
              <tr>
                <td>1200 × 630</td>
                <td>Social Sharing (1.91:1)</td>
                <td>Open Graph link preview graphics for websites</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.75rem;">
          <em>Note: Social platform dimension guidelines can change over time. Verify current specs on official platform developer pages.</em>
        </p>
      </div>
    </section>

    <!-- SECTION: JPG VS PNG VS WEBP -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">FORMAT GUIDE</div>
        <div class="section-heading">
          <h2>JPG vs PNG vs WebP</h2>
        </div>

        <!-- DESKTOP TABLE VIEW -->
        <div class="desktop-format-table table-container">
          <table class="guide-table">
            <thead>
              <tr>
                <th>Format</th>
                <th>Compression Type</th>
                <th>Transparency</th>
                <th>Ideal Use Cases</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>JPG / JPEG</strong></td>
                <td>Lossy</td>
                <td>No</td>
                <td>Photographs, complex color scenes, lightweight web photos</td>
              </tr>
              <tr>
                <td><strong>PNG</strong></td>
                <td>Lossless</td>
                <td>Yes</td>
                <td>Logos, UI icons, screenshots, graphics needing transparent backdrops</td>
              </tr>
              <tr>
                <td><strong>WebP</strong></td>
                <td>Lossy & Lossless</td>
                <td>Yes</td>
                <td>Modern websites seeking smaller file sizes at comparable visual quality</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- MOBILE STACKED COMPARISON CARDS -->
        <div class="mobile-format-cards">
          <div class="format-card">
            <div class="format-card-header">
              <h3 class="format-card-title">JPG / JPEG</h3>
            </div>
            <div class="format-card-body">
              <div class="format-card-row">
                <span class="format-card-label">Compression Type</span>
                <span class="format-card-value">Lossy</span>
              </div>
              <div class="format-card-row">
                <span class="format-card-label">Transparency</span>
                <span class="format-card-value">No</span>
              </div>
              <div class="format-card-row">
                <span class="format-card-label">Ideal Use Cases</span>
                <span class="format-card-value">Photographs, complex color scenes, lightweight web photos</span>
              </div>
            </div>
          </div>

          <div class="format-card">
            <div class="format-card-header">
              <h3 class="format-card-title">PNG</h3>
            </div>
            <div class="format-card-body">
              <div class="format-card-row">
                <span class="format-card-label">Compression Type</span>
                <span class="format-card-value">Lossless</span>
              </div>
              <div class="format-card-row">
                <span class="format-card-label">Transparency</span>
                <span class="format-card-value">Yes</span>
              </div>
              <div class="format-card-row">
                <span class="format-card-label">Ideal Use Cases</span>
                <span class="format-card-value">Logos, UI icons, screenshots, graphics needing transparent backdrops</span>
              </div>
            </div>
          </div>

          <div class="format-card">
            <div class="format-card-header">
              <h3 class="format-card-title">WebP</h3>
            </div>
            <div class="format-card-body">
              <div class="format-card-row">
                <span class="format-card-label">Compression Type</span>
                <span class="format-card-value">Lossy & Lossless</span>
              </div>
              <div class="format-card-row">
                <span class="format-card-label">Transparency</span>
                <span class="format-card-value">Yes</span>
              </div>
              <div class="format-card-row">
                <span class="format-card-label">Ideal Use Cases</span>
                <span class="format-card-value">Modern websites seeking smaller file sizes at comparable visual quality</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: WHY COMPRESS IMAGES? -->
    <section id="advantages" class="content-section">
      <div class="container">
        <div class="section-label">ADVANTAGES</div>
        <div class="section-heading">
          <h2>Why Compress Images?</h2>
        </div>

        <div class="feature-grid" style="margin-top: 1.5rem;">
          <article class="feature-card">
            <h3>Faster Website Load Times</h3>
            <p>Smaller image payloads accelerate browser rendering and improve mobile user experience.</p>
          </article>
          <article class="feature-card">
            <h3>Reduced Bandwidth & Storage</h3>
            <p>Compressed assets consume less server transfer data and decrease storage footprints.</p>
          </article>
          <article class="feature-card">
            <h3>Easier Email & Form Submissions</h3>
            <p>Can help reduce image files so they are more likely to fit email attachment and online-form size limits.</p>
          </article>
          <article class="feature-card">
            <h3>Faster Social Sharing</h3>
            <p>Lightweight image files upload rapidly over cellular networks.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION: BROWSER-BASED PROCESSING -->
    <section class="content-section">
      <div class="container">
        <div class="section-label">BROWSER PRIVACY</div>
        <div class="section-heading">
          <h2>Client-Side In-Browser Processing</h2>
        </div>

        <div class="legal-card" style="margin-top: 1.5rem;">
          <p>
            Image processing takes place locally in your web browser, so your selected image files are not uploaded to our server.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION: HOMEPAGE FAQ -->
    <section id="faq" class="faq-section">
      <div class="container">
        <div class="section-label">FAQ</div>
        <div class="section-heading">
          <h2>Frequently Asked Questions</h2>
        </div>

        <div class="faq-list">
          <details>
            <summary>How do I resize an image?</summary>
            <p>Upload your image file, specify your target width or height in pixels or percentage, keep aspect ratio locked to prevent distortion, choose your output format, and click Resize & compress.</p>
          </details>

          <details>
            <summary>Can I resize an image without changing its proportions?</summary>
            <p>Yes. Keep the aspect-ratio lock enabled while entering a new width or height. The tool automatically calculates the missing dimension proportionally.</p>
          </details>

          <details>
            <summary>What does aspect ratio mean?</summary>
            <p>Aspect ratio is the proportional relationship between an image's width and height, such as 16:9 for widescreen monitors or 1:1 for square social posts.</p>
          </details>

          <details>
            <summary>Does resizing reduce image quality?</summary>
            <p>Downscaling generally preserves good visual sharpness when the source image has sufficient resolution and appropriate processing settings are used. Upscaling a small image requires software to estimate missing pixels and can cause blurriness.</p>
          </details>

          <details>
            <summary>Can I make an image larger?</summary>
            <p>Yes, you can increase pixel dimensions, but enlarging very small images excessively will make them appear soft or pixelated because missing detail cannot be technically recreated.</p>
          </details>

          <details>
            <summary>How can I reduce an image's file size?</summary>
            <p>You can reduce file size by downscaling pixel dimensions, adjusting quality compression factor, converting to modern WebP format, or specifying a target file size in KB or MB.</p>
          </details>

          <details>
            <summary>What is the difference between JPG, PNG and WebP?</summary>
            <p>JPG uses lossy compression best for photos; PNG uses lossless compression supporting transparency; WebP is a modern web codec that produces smaller files at comparable visual quality.</p>
          </details>

          <details>
            <summary>Can I process multiple images at once?</summary>
            <p>Yes. Select or drag multiple supported image files into the workspace to batch process them together.</p>
          </details>

          <details>
            <summary>Can I target a specific file size in KB or MB?</summary>
            <p>Yes. Enter a target like 50 KB or 1 MB. The tool's search algorithm automatically adjusts JPEG or WebP compression to get as close as possible under your target limit.</p>
          </details>

          <details>
            <summary>Are my images uploaded to a server?</summary>
            <p>No. All image processing occurs locally inside your web browser using HTML5 Canvas APIs. Your images are never sent to or stored on our servers.</p>
          </details>
        </div>
      </div>
    </section>
