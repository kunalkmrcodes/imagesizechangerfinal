---
// CookieConsent.astro — Lightweight EU/CCPA Cookie Consent Banner
---

<div id="cookie-banner" class="cookie-banner hidden" role="dialog" aria-live="polite" aria-label="Cookie consent notice">
  <div class="container cookie-inner">
    <div class="cookie-text">
      <strong>🍪 Cookie & Privacy Notice</strong>
      <p>
        We use cookies to analyze aggregate traffic, improve user experience, and support website operations (including Google Analytics and Google AdSense). By continuing to use our website, you agree to our <a href="/privacy-policy">Privacy Policy</a>.
      </p>
    </div>
    <div class="cookie-actions">
      <button id="accept-cookies" class="cookie-btn primary" type="button">
        Accept All
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const banner = document.getElementById("cookie-banner");
    const acceptBtn = document.getElementById("accept-cookies");

    if (!banner || !acceptBtn) return;

    if (!localStorage.getItem("cookie_consent_accepted")) {
      banner.classList.remove("hidden");
    }

    acceptBtn.addEventListener("click", function () {
      localStorage.setItem("cookie_consent_accepted", "true");
      banner.classList.add("hidden");
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    z-index: 9999;
    background: var(--surface-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    padding: 1.25rem 1.5rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .cookie-banner.hidden {
    display: none;
  }

  .cookie-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cookie-text strong {
    display: block;
    color: var(--text-heading);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .cookie-text p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.45;
    margin: 0;
  }

  .cookie-text a {
    color: var(--accent);
    text-decoration: underline;
  }

  .cookie-actions {
    flex-shrink: 0;
  }

  .cookie-btn.primary {
    background: var(--accent);
    color: var(--accent-contrast);
    border: none;
    border-radius: 10px;
    padding: 0.65rem 1.35rem;
    font-weight: 750;
    font-size: 0.875rem;
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .cookie-btn.primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .cookie-banner {
      bottom: 1rem;
      left: 1rem;
      right: 1rem;
      padding: 1rem;
    }

    .cookie-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .cookie-actions {
      width: 100%;
    }

    .cookie-btn.primary {
      width: 100%;
    }
  }
</style>
