---
// Header.astro — Global Header Navigation for ImageSizeChanger
---

<header class="site-header">
  <div class="container nav-inner">

    <a class="brand" href="/" aria-label="ImageSizeChanger home">
      <img
        src="/favicon.png"
        alt="ImageSizeChanger Icon"
        class="brand-icon"
      />
      <span>ImageSizeChanger</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="/resize-image">Resize</a>
      <a href="/#features">Features</a>
      <a href="/guides">Guides</a>
      <a href="/#faq">FAQ</a>
    </nav>

    <div class="header-actions">
      <button
        id="themeToggleBtn"
        class="theme-toggle-btn"
        type="button"
        aria-label="Switch to light mode"
        title="Toggle light or dark theme"
      >
        <span class="theme-icon-sun" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </span>
        <span class="theme-icon-moon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </button>

      <button id="pwaInstallBtn" class="pwa-install-btn" type="button" style="display: none;">
        Install App ⚡
      </button>

      <a class="nav-cta" href="/#resize">
        Start resizing
      </a>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Open navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <div class="mobile-menu">
        <a href="/resize-image">Resize</a>
        <a href="/#features">Features</a>
        <a href="/guides">Guides</a>
        <a href="/#faq">FAQ</a>
        <button
          id="themeToggleBtnMobile"
          class="mobile-theme-toggle-btn"
          type="button"
          aria-label="Switch to light mode"
        >
          <span class="mobile-theme-icon theme-icon-sun" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </span>
          <span class="mobile-theme-icon theme-icon-moon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </span>
          <span class="theme-toggle-text">Toggle Theme</span>
        </button>
        <a class="mobile-menu-cta" href="/#resize">
          Start resizing
        </a>
        <button id="pwaInstallBtnMobile" class="pwa-install-btn-mobile" type="button" style="display: none;">
          ⚡ Install ImageSizeChanger App
        </button>
      </div>
    </details>

  </div>
</header>

<!-- ELEGANT FLOATING BOTTOM PWA INSTALL BANNER (MOBILE & TABLET) -->
<div id="pwaInstallBanner" class="pwa-install-banner" style="display: none;">
  <div class="pwa-banner-content">
    <img src="/favicon.png" alt="App Icon" class="pwa-banner-icon" />
    <div class="pwa-banner-text">
      <strong>Install ImageSizeChanger</strong>
      <span>Use offline directly from home screen</span>
    </div>
  </div>
  <div class="pwa-banner-actions">
    <button id="pwaBannerInstallBtn" class="pwa-banner-btn" type="button">Install</button>
    <button id="pwaBannerCloseBtn" class="pwa-banner-close" type="button" aria-label="Dismiss">×</button>
  </div>
</div>

<script>
  // Mobile Nav Dropdown Close Handler
  document.querySelectorAll('.mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      const details = link.closest('details');
      if (details) details.removeAttribute('open');
    });
  });

  // Theme Toggle Handler
  const themeToggleBtn = document.getElementById('themeToggleBtn');
  const themeToggleBtnMobile = document.getElementById('themeToggleBtnMobile');

  function updateThemeUI(theme: string) {
    const isLight = theme === 'light';
    const label = isLight ? 'Switch to dark mode' : 'Switch to light mode';
    const text = isLight ? 'Dark Mode 🌙' : 'Light Mode ☀️';

    if (themeToggleBtn) {
      themeToggleBtn.setAttribute('aria-label', label);
      themeToggleBtn.setAttribute('title', label);
    }
    if (themeToggleBtnMobile) {
      themeToggleBtnMobile.setAttribute('aria-label', label);
      const textSpan = themeToggleBtnMobile.querySelector('.theme-toggle-text');
      if (textSpan) textSpan.textContent = text;
    }

    const metaThemeColor = document.getElementById('meta-theme-color');
    if (metaThemeColor) {
      metaThemeColor.setAttribute('content', isLight ? '#ffffff' : '#07080d');
    }
  }

  function toggleTheme() {
    const isCurrentLight = document.documentElement.classList.contains('light-theme') || 
                           document.documentElement.getAttribute('data-theme') === 'light';
    const newTheme = isCurrentLight ? 'dark' : 'light';

    if (newTheme === 'light') {
      document.documentElement.classList.add('light-theme');
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.classList.remove('light-theme');
      document.documentElement.setAttribute('data-theme', 'dark');
    }

    try {
      localStorage.setItem('theme', newTheme);
    } catch (e) {}

    updateThemeUI(newTheme);
  }

  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', toggleTheme);
  }
  if (themeToggleBtnMobile) {
    themeToggleBtnMobile.addEventListener('click', toggleTheme);
  }

  // Initial Sync
  try {
    const currentTheme = localStorage.getItem('theme') || 'dark';
    updateThemeUI(currentTheme);
  } catch (e) {
    updateThemeUI('dark');
  }

  // PWA Installation Handler
  let deferredPrompt: any = null;
  const installBtn = document.getElementById('pwaInstallBtn');
  const installBtnMobile = document.getElementById('pwaInstallBtnMobile');
  const installBanner = document.getElementById('pwaInstallBanner');
  const bannerInstallBtn = document.getElementById('pwaBannerInstallBtn');
  const bannerCloseBtn = document.getElementById('pwaBannerCloseBtn');

  function isStandalone() {
    return window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
  }

  function showInstallPrompt() {
    if (isStandalone()) return;
    if (sessionStorage.getItem('pwa_banner_dismissed') === 'true') return;

    if (window.innerWidth > 768) {
      if (installBtn) installBtn.style.display = 'inline-flex';
    } else {
      if (installBanner) installBanner.style.display = 'flex';
      if (installBtnMobile) installBtnMobile.style.display = 'block';
    }
  }

  function hideInstallPrompts() {
    if (installBtn) installBtn.style.display = 'none';
    if (installBtnMobile) installBtnMobile.style.display = 'none';
    if (installBanner) installBanner.style.display = 'none';
  }

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    showInstallPrompt();
  });

  async function handleInstallTrigger() {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === 'accepted') {
      hideInstallPrompts();
    }
    deferredPrompt = null;
  }

  if (installBtn) installBtn.addEventListener('click', handleInstallTrigger);
  if (installBtnMobile) installBtnMobile.addEventListener('click', handleInstallTrigger);
  if (bannerInstallBtn) bannerInstallBtn.addEventListener('click', handleInstallTrigger);

  if (bannerCloseBtn) {
    bannerCloseBtn.addEventListener('click', () => {
      hideInstallPrompts();
      sessionStorage.setItem('pwa_banner_dismissed', 'true');
    });
  }

  window.addEventListener('appinstalled', () => {
    hideInstallPrompts();
    deferredPrompt = null;
  });
</script>
