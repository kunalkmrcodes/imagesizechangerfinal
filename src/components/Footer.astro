---
// Footer.astro — Global Footer Navigation for ImageSizeChanger
---

<footer class="site-footer">
  <div class="container footer-inner">

    <div class="footer-brand-col">
      <a class="brand footer-brand" href="/" aria-label="ImageSizeChanger home">
        <img
          src="/favicon.png"
          alt="ImageSizeChanger Icon"
          class="brand-icon"
        />
        <span>ImageSizeChanger</span>
      </a>
      <p>
        Free, private, and client-side browser image tools. Resize dimensions, compress file sizes, and convert formats directly on your device.
      </p>
    </div>

    <div class="footer-nav-grid">
      <div class="footer-col">
        <h4>Tools</h4>
        <a href="/resize-image">Image Size Changer</a>
        <a href="/compress-image">Compress Images</a>
        <a href="/convert-image">Convert Format</a>
      </div>

      <div class="footer-col">
        <h4>Resources</h4>
        <a href="/guides">Guides & Tutorials</a>
        <a href="/faq">FAQ</a>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about">About Us</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-service">Terms of Service</a>
      </div>
    </div>

  </div>

  <div class="container footer-bottom">
    <span>© 2026 ImageSizeChanger.info. All rights reserved.</span>
    <span>Fast · Private · 100% In-Browser</span>
  </div>
</footer>

<style>
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--border);
  }

  .footer-brand-col {
    max-width: 320px;
  }

  .footer-brand-col p {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(110px, 1fr));
    gap: 2.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col h4 {
    color: var(--text-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .footer-inner {
      flex-direction: column;
      gap: 2.5rem;
    }

    .footer-nav-grid {
      grid-template-columns: repeat(2, 1fr);
      width: 100%;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .footer-nav-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
