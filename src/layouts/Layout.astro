---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import PWAApp from "../components/PWAApp.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object | object[];
  adSensePublisherId?: string;
}

const {
  title = "ImageSizeChanger — Resize & Compress Images Online",
  description = "Resize and compress images online for free. Change dimensions, reduce file size and convert JPG, PNG and WebP images directly in your browser.",
  image = "/favicon.png",
  ogType = "website",
  noindex = false,
  structuredData,
  adSensePublisherId
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "https://www.imagesizechanger.info";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const imageURL = new URL(image, siteUrl).href;

const schemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Inline Theme Script (Early FOUC prevention - Defaults strictly to Dark Mode) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light') {
            document.documentElement.classList.add('light-theme');
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            // Default to Dark Mode for all new visitors or when theme === 'dark'
            document.documentElement.classList.remove('light-theme');
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {
          document.documentElement.classList.remove('light-theme');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="image resizer, compress image online, resize image free, change image dimensions, convert jpg to png, webp converter, free online photo resizer" />
    <meta name="author" content="ImageSizeChanger" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#07080d" id="meta-theme-color" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ImageSizeChanger" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Icons, Favicons & PWA Manifest -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ImageSizeChanger" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="ImageSizeChanger" />
    <meta name="msapplication-TileColor" content="#07080d" />
    <meta name="msapplication-TileImage" content="/icons/icon-192.png" />

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch((err) => {
            console.log('SW Registration failed: ', err);
          });
        });
      }
    </script>

    <!-- Structured Data (JSON-LD) -->
    {schemas.map((sd) => (
      <script type="application/ld+json" set:html={JSON.stringify(sd)} />
    ))}

    <!-- Google AdSense Site Verification -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6843466104107556"
      crossorigin="anonymous"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-3PXQHDHWP2"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-3PXQHDHWP2");
    </script>
  </head>

  <body>
    <PWAApp />
    <slot />
    <CookieConsent />
  </body>
</html>