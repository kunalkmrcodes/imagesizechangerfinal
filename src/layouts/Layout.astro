---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ImageSizeChanger — Resize & Compress Images Online",
  description = "Resize and compress images online for free. Change dimensions, reduce file size and convert JPG, PNG and WebP images directly in your browser."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#07080d"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />
  </head>

  <body>
    <slot />
  </body>
</html>